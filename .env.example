# Copie para .env na raiz. Nunca publique os valores reais.
DATABASE_URL=postgresql://blab:change-me@localhost:5432/blab_crm?schema=public
# Opcional: conexão direta/Session Pooler para migrations e Studio.
# Se vazio, a CLI usa DATABASE_URL. Não use prefixo NEXT_PUBLIC_.
DIRECT_URL=
# Opcional: CA PEM para TLS verificado no runtime (ex.: Vercel), sem caminho local.
DATABASE_SSL_CA=
# Gere com: openssl rand -base64 48
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Somente em infraestrutura com Host/X-Forwarded-Host confiáveis (Vercel configura automaticamente).
# AUTH_TRUST_HOST=true
# Exigidas somente para pnpm bootstrap. Remova depois de executar.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Opcional: banco local via docker compose (alinhe a senha em DATABASE_URL).
POSTGRES_PASSWORD=
